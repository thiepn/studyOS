NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Preferred modern server key. Legacy SUPABASE_SERVICE_ROLE_KEY remains accepted as a fallback.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stable canonical production origin. Required for Google Drive OAuth redirect matching.
APP_ORIGIN=http://localhost:3000

# StudyOS owns this Google Drive connection independently from ChatGPT or THIEPN Account.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
STUDY_DRIVE_TOKEN_KEY=

# file = narrow access, best when files are uploaded/selected through StudyOS.
# readonly = also read manually dropped files; StudyOS still scans only its Semester OS tree.
GOOGLE_DRIVE_SCOPE_MODE=readonly

# Study Calendar is an independent OAuth connection. These may reuse the same Google OAuth
# app/token key as Drive by leaving them blank; the selected Google account remains independent.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
STUDY_CALENDAR_TOKEN_KEY=
