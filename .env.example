NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://localhost:3000

# StudyOS owns this Google Drive connection independently from ChatGPT or THIEPN Account.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
STUDY_DRIVE_TOKEN_KEY=
# file = narrow access, best when files are uploaded/selected through StudyOS.
# readonly = also read manually dropped files; StudyOS still scans only its Semester OS tree. This is a Google restricted scope.
GOOGLE_DRIVE_SCOPE_MODE=readonly
